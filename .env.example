# 변수 이름만 적는다. 실제 값은 .env(커밋 안 함)·배포 환경·GitHub Secrets에 넣는다. 용도는 README 환경변수 표를 본다.
BACKEND_URL=
RELEASE_ID=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# 서비스 AI 기능을 쓸 때만 필요 (대시보드 자료 → API 키에서 발급)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
# OPT-2 주변 음식점 지도 (카카오맵). 키는 카카오 개발자 콘솔에서 직접 발급한다
# KAKAO_REST_API_KEY는 서버가 장소 검색에 쓴다. KAKAO_MAP_APP_KEY는 지도 SDK 키로,
# 화면이 서버에서 읽어 브라우저로 내려 준다(NEXT_PUBLIC_을 쓰지 않는다. 빌드 시점에 박히면 런타임에 바꿀 수 없다)
KAKAO_REST_API_KEY=
KAKAO_MAP_APP_KEY=
# 위치 권한을 거부했거나 시연할 때 쓰는 기본 좌표와 반경. 조선대 주변 값은 TODO(확인)
NEARBY_DEFAULT_LAT=
NEARBY_DEFAULT_LNG=
NEARBY_RADIUS_M=
